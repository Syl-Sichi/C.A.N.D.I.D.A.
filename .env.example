# C.A.N.D.I.D.A. — copy to .env.local and fill in

# ElevenLabs (voice — shared ROSE-class speech for C.A.N.D.I.D.A.)
ELEVENLABS_API_KEY=
# Optional: pick a voice from https://elevenlabs.io/app/voice-library
# Default is Rachel (21m00Tcm4TlvDq8ikWAM). Clone or pick one close to ROSE.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional model
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Future: C.A.N.D.I.D.A.'s own LLM endpoint (not shared with Z.E.L.D.A. / K.O.S.I.)
